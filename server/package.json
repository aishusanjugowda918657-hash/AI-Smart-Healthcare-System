{
  "name": "ai-smart-healthcare-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:emulator": "firebase emulators:start --only firestore,auth --project demo-project & timeout /t 5 /nobreak && cross-env FIRESTORE_EMULATOR_HOST=localhost:8080 FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 GCLOUD_PROJECT=demo-project FLAG_SCHEDULER=false node scripts/seedEmulatorData.js && cross-env FIRESTORE_EMULATOR_HOST=localhost:8080 FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 GCLOUD_PROJECT=demo-project FLAG_SCHEDULER=false node --watch server.js",
    "dev:emulator:server": "cross-env FIRESTORE_EMULATOR_HOST=localhost:8080 FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 GCLOUD_PROJECT=demo-project FLAG_SCHEDULER=false node --watch server.js",
    "seed:emulator": "cross-env FIRESTORE_EMULATOR_HOST=localhost:8080 FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 GCLOUD_PROJECT=demo-project node scripts/seedEmulatorData.js",
    "seed": "node scripts/seedDemoData.js",
    "seed:doctors": "node scripts/seedDemoDoctors.js",
    "seed:firestore": "node scripts/seedDoctorsFirestore.js",
    "seed:patients": "node scripts/seedDemoPatients.js",
    "doctor": "node scripts/doctor.js",
    "backfill:name-lower": "node scripts/backfillNameLower.js",
    "bootstrap": "node scripts/bootstrap.js",
    "reset:everything": "node scripts/resetEverything.js",
    "reset:patient": "node scripts/resetPatientData.js",
    "test": "vitest run",
    "test:emu": "firebase emulators:exec --only firestore,auth \"vitest run\" --project demo-project",
    "smoke:test": "vitest run tests/smoke.test.js"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.23",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.2.0",
    "firebase-admin": "^12.4.0",
    "helmet": "^8.3.0",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "supertest": "^7.0.0",
    "vitest": "^2.0.5"
  }
}
