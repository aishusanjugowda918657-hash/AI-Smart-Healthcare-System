# ===========================================================
# AI Smart Healthcare System — Environment Example
# Copy to server/.env and client/.env and fill in your values.
# ===========================================================

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
HOSPITAL_TZ=Asia/Kolkata

# Gemini API — leave blank to disable AI enrichment (FLAG_AI=false)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Firebase Admin — choose ONE of the options below
# Option A (service account file — recommended for production):
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com

# Option B (individual env vars — useful for CI/CD):
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your_project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
# VITE_FIREBASE_PROJECT_ID=your_project_id

# ── Emulator (local dev — set these when using npm run dev:emulator) ─────────
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# GCLOUD_PROJECT=demo-project

CLIENT_ORIGIN=http://localhost:5173
INTERNAL_TICK_SECRET=change_me_in_production
ACTION_TOKEN_SECRET=change_me_in_production

# ── Feature Flags ────────────────────────────────────────────
FLAG_AI=true
FLAG_PUSH=true
# Scheduler default is FALSE to avoid burning Firestore quota on first run.
# Set to true only when using the emulator (npm run dev:emulator sets it for you).
FLAG_SCHEDULER=false

# ── Client (Vite — copy to client/.env) ─────────────────────
VITE_API_BASE_URL=http://localhost:5000/api
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_VAPID_KEY=your_firebase_vapid_key_here
